# Super-admin bootstrap (consumed by `bun run bootstrap:admin`).
# Public sign-up is disabled; this is the only path to create the first user.
# Use a strong password (16+ chars). This account has full admin powers.
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_NAME=Admin
SUPERUSER_PASSWORD=change-me-to-something-strong
